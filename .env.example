# Copy to .env (ignored by git) and adjust. Dev defaults only; never commit real secrets.
POSTGRES_USER=morph
POSTGRES_PASSWORD=morph
POSTGRES_DB=morph
DATABASE_URL=postgresql+psycopg://morph:morph@localhost:5432/morph
CRM_API_KEY=crm-dev-key
SUPPORT_TOKEN=support-dev-token
ADMIN_TOKEN=admin-dev-token
# Embeddings: "fastembed" (real, downloads BAAI/bge-small-en-v1.5 once) or "fake" (tests only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LLM (Phase 1: Groq free tier first). Put the real key in the gitignored .env, never here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
