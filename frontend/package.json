{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "tsc -b && vite build",
    "build:live": "tsc -b && vite build --mode live",
    "preview": "vite preview",
    "data": "node --experimental-strip-types scripts/build-demo-data.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:bundle": "node --experimental-strip-types scripts/check-bundle.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
