  "scenarios": [
    {
      "id": "crm_customer_to_support_user",
      "label": "S1",
      "source": "crm.Customer",
      "target": "support.User",
      "description": "Copy CRM customers into the Support desk as users. The two systems differ in id format, name structure, enum vocabulary, phone format, timestamp type and segment/tier semantics."
    },
    {
      "id": "support_user_to_crm_customer",
      "label": "S3",
      "source": "support.User",
      "target": "crm.Customer",
      "description": "The reverse direction: create CRM customers from Support desk users. Several fields are genuinely hard here: the id must come from externalRef (and cannot be invented for users that were never imported), the joined name has to be split, the phone gets its \"+\" back, the epoch becomes an ISO string, and the CRM segment cannot be recovered from the support tier."
    },
    {
      "id": "crm_v2_to_support_v2",
      "label": "S4",
      "source": "crm.Customer",
      "target": "support.User",
      "description": "The first integration again, against the drifted v2 contracts: the CRM renamed phone to phone_number and Support renamed tier to serviceTier. Everything else is unchanged, so a mapping tied to the old names must be re-derived."
    }
  ],
